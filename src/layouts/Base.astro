---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Pied from '../components/Pied.astro';
import { site } from '../data/site';

interface Props {
  titre: string;
  description?: string;
  /** Données structurées JSON-LD propres à la page */
  donnees?: object[];
  /** Masque les liens d'ancre de la navigation (pages légales) */
  navSimple?: boolean;
  indexable?: boolean;
}

const { titre, description = site.description, donnees = [], navSimple = false, indexable = true } = Astro.props;
const canonique = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const image = new URL('/partage.png', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexable && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141513" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nom} — ${site.promesse}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- L'état « caché avant apparition » n'existe que si JavaScript tourne -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    {donnees.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Nav simple={navSimple} />
    <main id="contenu">
      <slot />
    </main>
    <Pied />

    <script>
      import { lancerApparitions } from '../scripts/apparition';
      lancerApparitions();
    </script>
  </body>
</html>
