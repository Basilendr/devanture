---
// Illustrations des faux sites d'exemple : formes simples, couleurs tirées de la maquette
// (--m-accent, --m-doux, --m-fond, --m-texte), aucune image à charger.
interface Props {
  type: 'fleuriste' | 'traiteur' | 'galerie' | 'institut' | 'garage' | 'restaurant';
}
const { type } = Astro.props;
---

<svg class="illu" viewBox="0 0 320 200" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  <rect width="320" height="200" fill="var(--m-doux)" />
  {
    type === 'fleuriste' && (
      <g>
        <rect x="0" y="150" width="320" height="50" fill="var(--m-fond)" opacity="0.5" />
        <path d="M128 150h64l-8 44h-48z" fill="var(--m-accent)" />
        <g stroke="var(--m-texte)" stroke-width="3" opacity="0.55" fill="none">
          <path d="M160 150c0-30-8-55-26-78" />
          <path d="M160 150c0-35 4-62 12-92" />
          <path d="M160 150c2-28 14-48 34-64" />
        </g>
        <ellipse cx="146" cy="104" rx="14" ry="7" transform="rotate(-40 146 104)" fill="var(--m-texte)" opacity="0.35" />
        <ellipse cx="180" cy="112" rx="14" ry="7" transform="rotate(35 180 112)" fill="var(--m-texte)" opacity="0.35" />
        <g fill="var(--m-fleur)">
          <circle cx="134" cy="68" r="16" />
          <circle cx="172" cy="54" r="19" />
          <circle cx="196" cy="84" r="14" />
        </g>
        <g fill="var(--m-fond)" opacity="0.7">
          <circle cx="134" cy="68" r="5" />
          <circle cx="172" cy="54" r="6" />
          <circle cx="196" cy="84" r="4.5" />
        </g>
      </g>
    )
  }
  {
    type === 'traiteur' && (
      <g>
        <rect x="0" y="130" width="320" height="70" fill="var(--m-fond)" opacity="0.55" />
        <ellipse cx="160" cy="138" rx="92" ry="16" fill="var(--m-fond)" />
        <ellipse cx="160" cy="134" rx="92" ry="16" fill="var(--m-texte)" opacity="0.12" />
        <path d="M92 132a68 62 0 0 1 136 0z" fill="var(--m-accent)" />
        <circle cx="160" cy="64" r="7" fill="var(--m-accent)" />
        <path d="M118 112a46 44 0 0 1 22-30" stroke="var(--m-fond)" stroke-width="4" fill="none" opacity="0.55" stroke-linecap="round" />
        <ellipse cx="62" cy="160" rx="30" ry="8" fill="var(--m-texte)" opacity="0.15" />
        <ellipse cx="258" cy="160" rx="30" ry="8" fill="var(--m-texte)" opacity="0.15" />
        <circle cx="54" cy="152" r="8" fill="var(--m-fleur)" />
        <circle cx="70" cy="154" r="6" fill="var(--m-accent)" opacity="0.7" />
        <circle cx="252" cy="152" r="7" fill="var(--m-accent)" opacity="0.7" />
        <circle cx="266" cy="153" r="7" fill="var(--m-fleur)" />
      </g>
    )
  }
  {
    type === 'galerie' && (
      <g>
        <rect x="0" y="160" width="320" height="40" fill="var(--m-texte)" opacity="0.1" />
        <rect x="34" y="40" width="76" height="96" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="3" />
        <rect x="46" y="52" width="52" height="72" fill="var(--m-accent)" />
        <circle cx="72" cy="78" r="12" fill="var(--m-fleur)" />
        <rect x="128" y="28" width="96" height="70" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="3" />
        <path d="M140 86l22-26 16 18 12-10 22 18z" fill="var(--m-accent)" opacity="0.8" />
        <rect x="128" y="108" width="44" height="44" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="3" />
        <rect x="138" y="118" width="24" height="24" fill="var(--m-fleur)" />
        <rect x="182" y="108" width="42" height="44" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="3" />
        <path d="M190 144h26M190 136h18" stroke="var(--m-texte)" stroke-width="3" opacity="0.5" />
        <rect x="242" y="52" width="48" height="80" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="3" />
        <rect x="252" y="62" width="28" height="60" fill="var(--m-accent)" opacity="0.5" />
        <rect x="104" y="170" width="112" height="10" rx="2" fill="var(--m-texte)" opacity="0.35" />
      </g>
    )
  }
  {
    type === 'institut' && (
      <g>
        <circle cx="236" cy="70" r="46" fill="var(--m-fond)" opacity="0.6" />
        <ellipse cx="150" cy="166" rx="66" ry="14" fill="var(--m-accent)" />
        <ellipse cx="150" cy="140" rx="52" ry="13" fill="var(--m-fleur)" />
        <ellipse cx="150" cy="117" rx="38" ry="11" fill="var(--m-accent)" opacity="0.75" />
        <ellipse cx="150" cy="98" rx="24" ry="9" fill="var(--m-fleur)" opacity="0.85" />
        <path d="M222 168c-4-40 14-74 48-92-2 40-20 72-48 92z" fill="var(--m-texte)" opacity="0.3" />
        <path d="M222 168c10-30 22-52 40-80" stroke="var(--m-fond)" stroke-width="2" fill="none" opacity="0.7" />
        <path d="M74 60c0 12-8 18-8 26a8 8 0 0 0 16 0c0-8-8-14-8-26z" fill="var(--m-accent)" opacity="0.6" />
      </g>
    )
  }
  {
    type === 'garage' && (
      <g>
        <rect x="0" y="156" width="320" height="44" fill="var(--m-texte)" opacity="0.18" />
        <path d="M18 156h284" stroke="var(--m-fond)" stroke-width="3" stroke-dasharray="18 14" opacity="0.6" />
        <path d="M66 132l20-34c4-7 10-10 18-10h92c8 0 14 3 19 9l26 35h20c8 0 13 5 13 12v8H52v-8c0-7 6-12 14-12z" fill="var(--m-accent)" />
        <path d="M100 96h40v34H82zM150 96h42c4 0 7 1 9 4l20 30h-71z" fill="var(--m-fond)" opacity="0.75" />
        <circle cx="104" cy="152" r="17" fill="var(--m-texte)" />
        <circle cx="104" cy="152" r="7" fill="var(--m-fond)" />
        <circle cx="222" cy="152" r="17" fill="var(--m-texte)" />
        <circle cx="222" cy="152" r="7" fill="var(--m-fond)" />
        <path d="M268 40a14 14 0 0 0-18 18l-22 22 8 8 22-22a14 14 0 0 0 18-18l-8 8-8-8z" fill="var(--m-fleur)" />
      </g>
    )
  }
  {
    type === 'restaurant' && (
      <g>
        <path d="M160 0v42" stroke="var(--m-texte)" stroke-width="2" opacity="0.5" />
        <path d="M134 62a26 22 0 0 1 52 0z" fill="var(--m-accent)" />
        <ellipse cx="160" cy="70" rx="40" ry="10" fill="var(--m-fleur)" opacity="0.35" />
        <rect x="40" y="130" width="240" height="10" rx="3" fill="var(--m-texte)" opacity="0.7" />
        <path d="M70 140v52M250 140v52" stroke="var(--m-texte)" stroke-width="6" opacity="0.7" />
        <path d="M120 96h20l-3 20a7 7 0 0 1-14 0z" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="2.5" />
        <path d="M130 123v7" stroke="var(--m-texte)" stroke-width="2.5" />
        <path d="M118 104h24" stroke="var(--m-fleur)" stroke-width="6" />
        <path d="M180 96h20l-3 20a7 7 0 0 1-14 0z" fill="var(--m-fond)" stroke="var(--m-texte)" stroke-width="2.5" />
        <path d="M190 123v7" stroke="var(--m-texte)" stroke-width="2.5" />
        <path d="M178 104h24" stroke="var(--m-fleur)" stroke-width="6" />
        <circle cx="160" cy="118" r="8" fill="var(--m-accent)" />
        <path d="M160 110v-10" stroke="var(--m-texte)" stroke-width="2" opacity="0.6" />
      </g>
    )
  }
</svg>

<style>
  .illu {
    width: 100%;
    height: 100%;
  }
</style>
