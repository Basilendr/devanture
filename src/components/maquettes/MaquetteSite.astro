---
// Un faux site de commerce, FICTIF, affiché dans un écran de téléphone.
// Toutes les données viennent de src/data/maquettes.ts.
import Illustration from './Illustration.astro';
import type { Maquette } from '../../data/maquettes';

interface Props {
  m: Maquette;
  /** Version longue (téléphone de l'accueil) : toutes les sections */
  complet?: boolean;
}
const { m, complet = false } = Astro.props;
const style = `--m-fond:${m.couleurs.fond};--m-texte:${m.couleurs.texte};--m-accent:${m.couleurs.accent};--m-sur-accent:${m.couleurs.surAccent};--m-doux:${m.couleurs.doux};--m-fleur:${m.couleurs.fleur};--m-police:${m.police}`;
---

<div class="ms" style={style} aria-hidden="true">
  <div class="ms__barre">
    <span class="ms__nom">{m.nom}</span>
    <span class="ms__menu"><i></i><i></i></span>
  </div>

  <div class="ms__heros">
    <Illustration type={m.type} />
  </div>

  <div class="ms__corps">
    <p class="ms__lieu">{m.metier} · {m.quartier}</p>
    <p class="ms__titre">{m.accroche}</p>
    <div class="ms__boutons">
      <span class="ms__btn ms__btn--plein">{m.action}</span>
      <span class="ms__btn">Itinéraire</span>
    </div>

    <p class="ms__ouvert"><i></i>{m.ouvert}</p>

    <p class="ms__h">{m.titreServices}</p>
    <ul class="ms__liste">
      {
        m.services.map(([nom, prix]) => (
          <li>
            <span>{nom}</span>
            <span class="ms__prix">{prix}</span>
          </li>
        ))
      }
    </ul>

    {
      complet && (
        <>
          <div class="ms__galerie">
            <span />
            <span />
            <span />
          </div>

          <p class="ms__h">Horaires</p>
          <ul class="ms__liste ms__liste--fine">
            {m.horaires.map(([j, h]) => (
              <li>
                <span>{j}</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <p class="ms__h">Nous trouver</p>
          <div class="ms__plan">
            <span class="ms__epingle" />
          </div>
          <p class="ms__petit">{m.adresse}</p>

          <p class="ms__h">Nous écrire</p>
          <div class="ms__champ">Votre nom</div>
          <div class="ms__champ">Votre message</div>
          <span class="ms__btn ms__btn--plein ms__btn--large">Envoyer</span>

          <div class="ms__pied">
            <span>Instagram</span>
            <span>Appeler</span>
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .ms {
    background: var(--m-fond);
    color: var(--m-texte);
    font-size: 0.8125rem;
    line-height: 1.4;
    min-height: 100%;
    user-select: none;
    -webkit-user-select: none;
  }

  .ms__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.5rem 1rem 0.625rem;
  }

  .ms__nom {
    font-family: var(--m-police);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ms__menu {
    display: grid;
    gap: 0.25rem;
  }

  .ms__menu i {
    display: block;
    width: 1.125rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .ms__heros {
    aspect-ratio: 16 / 10;
    margin-inline: 0.75rem;
    border-radius: 0.875rem;
    overflow: hidden;
  }

  .ms__corps {
    padding: 0.875rem 1rem 1.5rem;
  }

  .ms__lieu {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .ms__titre {
    margin-top: 0.25rem;
    font-family: var(--m-police);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .ms__boutons {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .ms__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.125rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--m-texte) 25%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .ms__btn--plein {
    background: var(--m-accent);
    border-color: var(--m-accent);
    color: var(--m-sur-accent);
  }

  .ms__btn--large {
    width: 100%;
    margin-top: 0.5rem;
  }

  .ms__ouvert {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .ms__ouvert i {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--m-accent);
  }

  .ms__h {
    margin-top: 1.25rem;
    margin-bottom: 0.375rem;
    font-family: var(--m-police);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .ms__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ms__liste li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4375rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--m-texte) 12%, transparent);
  }

  .ms__liste--fine li {
    padding: 0.3125rem 0;
    font-size: 0.75rem;
  }

  .ms__prix {
    font-weight: 600;
    white-space: nowrap;
  }

  .ms__galerie {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 3.5rem 3.5rem;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }

  .ms__galerie span {
    border-radius: 0.625rem;
    background: var(--m-doux);
  }

  .ms__galerie span:first-child {
    grid-row: span 2;
    background: color-mix(in srgb, var(--m-accent) 70%, var(--m-doux));
  }

  .ms__galerie span:last-child {
    background: color-mix(in srgb, var(--m-fleur) 60%, var(--m-doux));
  }

  .ms__plan {
    position: relative;
    height: 6.5rem;
    border-radius: 0.75rem;
    background:
      linear-gradient(90deg, transparent 46%, color-mix(in srgb, var(--m-fond) 85%, transparent) 46% 54%, transparent 54%),
      linear-gradient(0deg, transparent 58%, color-mix(in srgb, var(--m-fond) 85%, transparent) 58% 64%, transparent 64%),
      linear-gradient(35deg, transparent 30%, color-mix(in srgb, var(--m-fond) 70%, transparent) 30% 34%, transparent 34%),
      var(--m-doux);
  }

  .ms__epingle {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 1rem;
    height: 1rem;
    border-radius: 50% 50% 50% 0;
    background: var(--m-accent);
    transform: translate(-50%, -50%) rotate(-45deg);
    box-shadow: 0 0 0 3px var(--m-fond);
  }

  .ms__petit {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .ms__champ {
    margin-top: 0.375rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--m-texte) 20%, transparent);
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .ms__pied {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--m-texte) 12%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
