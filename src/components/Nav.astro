---
import { site } from '../data/site';
interface Props {
  simple?: boolean;
}
const { simple = false } = Astro.props;
const racine = simple ? '/' : '';
---

<div class="sentinelle" aria-hidden="true"></div>
<header class="nav matiere" data-nav>
  <nav class="nav__interieur conteneur" aria-label="Navigation principale">
    <a class="nav__logo" href="/" aria-label={`${site.nom}, accueil`}>
      <span class="nav__marque" aria-hidden="true"></span>
      {site.nom}
    </a>
    <ul class="nav__liens" role="list">
      <li><a href={`${racine}#exemples`}>Exemples</a></li>
      <li><a href={`${racine}#tarifs`}>Tarifs</a></li>
      <li><a href={`${racine}#questions`}>Questions</a></li>
    </ul>
    <a class="btn btn--principal nav__cta" href={`${racine}#maquette`}>
      Ma maquette gratuite
    </a>
  </nav>
</header>

<style>
  .sentinelle {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-top: 0;
  }

  /* Pas de trait dur sous la barre : un léger fondu, seulement quand le contenu passe dessous */
  .nav::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: 1rem;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.05), transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .nav[data-defile]::after {
    opacity: 1;
  }

  .nav__interieur {
    display: flex;
    align-items: center;
    gap: var(--e-4);
    height: var(--nav-h);
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-right: auto;
    color: var(--texte);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* Petit store de devanture, en pure CSS */
  .nav__marque {
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 0.375rem;
    background:
      repeating-linear-gradient(90deg, var(--sur-accent) 0 0.1875rem, transparent 0.1875rem 0.375rem) top / 100% 0.4375rem no-repeat,
      var(--accent);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .nav__liens {
    display: none;
    gap: var(--e-1);
    margin-right: var(--e-3);
  }

  .nav__liens a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--e-3);
    border-radius: var(--r-rond);
    color: var(--texte-2);
    font-size: var(--t-petit);
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav__liens a:hover {
    color: var(--texte);
  }

  .nav__cta {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: var(--t-petit);
  }

  @media (min-width: 48rem) {
    .nav__liens {
      display: flex;
    }
  }

  @media (prefers-color-scheme: dark) {
    .nav::after {
      background: linear-gradient(to bottom, rgb(0 0 0 / 0.25), transparent);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const sentinelle = document.querySelector('.sentinelle');
  if (nav && sentinelle) {
    new IntersectionObserver(([e]) => nav.toggleAttribute('data-defile', !e.isIntersecting)).observe(sentinelle);
  }
</script>
