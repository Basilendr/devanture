---
// Cadre de téléphone dont on fait défiler l'écran : au doigt (défilement natif du système),
// à la souris (glisser + lancer, script telephone.ts), à la molette ou au clavier.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="tel" data-telephone>
  <div class="tel__ecran" data-ecran tabindex="0" role="region" aria-label={label}>
    <div class="tel__contenu" data-contenu>
      <slot />
    </div>
  </div>
  <span class="tel__ilot" aria-hidden="true"></span>
</div>

<style>
  .tel {
    position: relative;
    width: min(18.5rem, 78vw);
    aspect-ratio: 9 / 19;
    padding: 0.625rem;
    border-radius: 3rem;
    background: var(--appareil);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      var(--ombre-3);
  }

  .tel__ecran {
    height: 100%;
    border-radius: 2.4rem;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    background: #fff;
    cursor: grab;
    /* Le défilement au doigt reste celui du système (élan et rebond natifs) */
    overscroll-behavior-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .tel__ecran::-webkit-scrollbar {
    display: none;
  }

  .tel__ecran:focus-visible {
    outline-offset: 0.75rem;
    border-radius: 2.4rem;
  }

  .tel__ecran[data-saisi] {
    cursor: grabbing;
  }

  .tel__contenu {
    min-height: 100%;
  }

  .tel__ilot {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--appareil);
    transform: translateX(-50%);
    pointer-events: none;
  }
</style>

<script>
  import { brancherTelephones } from '../scripts/telephone';
  brancherTelephones();
</script>
