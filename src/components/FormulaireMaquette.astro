---
import { site, metiers } from '../data/site';
import Icone from './Icone.astro';
---

<section id="maquette" class="section section--alt" aria-labelledby="titre-maquette">
  <div class="conteneur form-zone">
    <div class="form-zone__texte" data-apparition>
      <p class="surtitre">Maquette gratuite</p>
      <h2 id="titre-maquette" class="titre-2">Recevez votre maquette gratuite.</h2>
      <p class="chapo">
        Laissez-nous votre numéro. On vous appelle pour convenir des photos, et vous recevez la maquette de
        votre page d’accueil. Sans engagement.
      </p>
      <ul class="form-zone__points" role="list">
        <li><Icone nom="coche" />Gratuit, sans engagement</li>
        <li><Icone nom="coche" />Faite avec les photos de votre commerce</li>
        <li><Icone nom="coche" />Site en ligne en {site.delai} si vous dites oui</li>
      </ul>
      <p class="form-zone__tel">
        Vous préférez appeler ?
        <a href={`tel:${site.telephoneLien}`}>{site.telephone}</a>
      </p>
    </div>

    <div class="carte-form" data-apparition="1">
      <form
        class="form"
        action={site.formulaireAdresse}
        method="POST"
        data-formulaire
        aria-describedby="form-obligatoire"
      >
        <input type="hidden" name="_subject" value="Nouvelle demande de maquette — Devanture" />
        <!-- Piège anti-robots : invisible pour les humains -->
        <div class="form__piege" aria-hidden="true">
          <label>Ne pas remplir <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p id="form-obligatoire" class="form__note">Les champs marqués * sont obligatoires.</p>

        <div class="champ">
          <label for="f-nom">Nom du commerce *</label>
          <input id="f-nom" name="commerce" type="text" required autocomplete="organization" aria-describedby="f-nom-msg" />
          <p class="champ__msg" id="f-nom-msg"></p>
        </div>

        <div class="form__ligne">
          <div class="champ">
            <label for="f-metier">Métier *</label>
            <select id="f-metier" name="metier" required aria-describedby="f-metier-msg">
              <option value="">Choisir…</option>
              {metiers.map((m) => <option>{m}</option>)}
            </select>
            <p class="champ__msg" id="f-metier-msg"></p>
          </div>

          <div class="champ">
            <label for="f-quartier">Ville ou arrondissement *</label>
            <input
              id="f-quartier"
              name="quartier"
              type="text"
              required
              autocomplete="address-level2"
              placeholder="Paris 16e, Puteaux…"
              aria-describedby="f-quartier-msg"
            />
            <p class="champ__msg" id="f-quartier-msg"></p>
          </div>
        </div>

        <div class="champ">
          <label for="f-tel">Téléphone *</label>
          <input
            id="f-tel"
            name="telephone"
            type="tel"
            required
            inputmode="tel"
            autocomplete="tel"
            placeholder="06 12 34 56 78"
            aria-describedby="f-tel-msg"
          />
          <p class="champ__msg" id="f-tel-msg"></p>
        </div>

        <div class="champ">
          <label for="f-email">E-mail <span class="facultatif">(facultatif)</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="f-email-msg" />
          <p class="champ__msg" id="f-email-msg"></p>
        </div>

        <div class="champ">
          <label for="f-message">Message <span class="facultatif">(facultatif)</span></label>
          <textarea id="f-message" name="message" rows="3" placeholder="Votre adresse, votre Instagram, une question…"></textarea>
        </div>

        <div class="champ champ--coche">
          <input id="f-rgpd" name="consentement" type="checkbox" value="oui" required aria-describedby="f-rgpd-msg" />
          <label for="f-rgpd">
            J’accepte que Devanture utilise ces informations pour me recontacter au sujet de ma maquette.
            <a href="/confidentialite">Politique de confidentialité</a>.
          </label>
          <p class="champ__msg" id="f-rgpd-msg"></p>
        </div>

        <p class="form__erreur" data-erreur-globale role="alert"></p>

        <button class="btn btn--principal btn--grand form__envoyer" type="submit">
          <span data-libelle>Recevoir ma maquette gratuite</span>
        </button>
      </form>

      <div class="confirmation" data-confirmation hidden>
        <span class="confirmation__icone"><Icone nom="coche" /></span>
        <h3 class="titre-3" tabindex="-1" data-confirmation-titre>Merci, c’est bien reçu.</h3>
        <p>
          Nous vous appelons très vite <span data-confirmation-tel></span> pour convenir des photos. La maquette est
          gratuite et ne vous engage à rien.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .form-zone {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .form-zone__texte .chapo {
    margin-top: var(--e-4);
    max-width: 30rem;
  }

  .form-zone__points {
    display: grid;
    gap: var(--e-2);
    margin-top: var(--e-5);
  }

  .form-zone__points li {
    display: flex;
    gap: var(--e-2);
    align-items: center;
  }

  .form-zone__points :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--accent-texte);
  }

  .form-zone__tel {
    margin-top: var(--e-6);
    color: var(--texte-2);
  }

  .form-zone__tel a {
    display: inline-block;
    padding-block: 0.625rem;
    font-weight: 600;
  }

  .carte-form {
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border-radius: var(--r-4);
    background: var(--surface);
    border: 1px solid var(--bord);
    box-shadow: var(--ombre-2);
  }

  .form {
    display: grid;
    gap: var(--e-4);
  }

  .form__note {
    color: var(--texte-2);
    font-size: var(--t-mini);
  }

  .form__piege {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__ligne {
    display: grid;
    gap: var(--e-4);
  }

  .champ {
    display: grid;
    gap: 0.375rem;
  }

  .champ label {
    font-size: var(--t-petit);
    font-weight: 600;
  }

  .facultatif {
    color: var(--texte-2);
    font-weight: 400;
  }

  .champ input:not([type='checkbox']),
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--bord-fort);
    border-radius: var(--r-1);
    background: var(--surface);
    font-size: 1rem;
    transition: border-color 150ms ease;
  }

  .champ select {
    appearance: none;
    padding-right: 2.5rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--texte-2) 50%),
      linear-gradient(135deg, var(--texte-2) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 50%,
      calc(100% - 0.9rem) 50%;
    background-size: 0.375rem 0.375rem;
    background-repeat: no-repeat;
  }

  .champ textarea {
    resize: vertical;
    min-height: 5.5rem;
  }

  .champ :is(input, select, textarea)::placeholder {
    color: var(--texte-3);
  }

  .champ :is(input, select, textarea):focus-visible {
    outline-offset: 1px;
    border-color: var(--focus);
  }

  .champ [aria-invalid='true'] {
    border-color: var(--erreur) !important;
  }

  .champ__msg {
    min-height: 0;
    color: var(--erreur);
    font-size: var(--t-mini);
    font-weight: 500;
  }

  .champ__msg:empty {
    display: none;
  }

  .champ--coche {
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--e-3);
  }

  .champ--coche input {
    width: 1.375rem;
    height: 1.375rem;
    margin: 0.125rem 0 0;
    accent-color: var(--accent);
  }

  .champ--coche label {
    font-weight: 400;
    color: var(--texte-2);
  }

  .champ--coche .champ__msg {
    grid-column: 2;
  }

  .form__erreur:empty {
    display: none;
  }

  .form__erreur {
    padding: var(--e-3) var(--e-4);
    border-radius: var(--r-1);
    background: var(--erreur-doux);
    color: var(--erreur);
    font-size: var(--t-petit);
    font-weight: 500;
  }

  .form__envoyer {
    width: 100%;
  }

  .form__envoyer[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .confirmation {
    display: grid;
    justify-items: start;
    gap: var(--e-3);
    padding-block: var(--e-5);
  }

  .confirmation[hidden] {
    display: none;
  }

  .confirmation__icone {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--sur-accent);
  }

  .confirmation__icone :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .confirmation p {
    color: var(--texte-2);
  }

  @media (min-width: 36rem) {
    .form__ligne {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 60rem) {
    .form-zone {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .form-zone__texte {
      position: sticky;
      top: calc(var(--nav-h) + var(--e-6));
    }
  }
</style>

<script>
  import { brancherFormulaires } from '../scripts/formulaire';
  brancherFormulaires();
</script>
