---
// Questionnaire en plusieurs étapes. Les questions sont dans src/data/questionnaire.ts.
// Sans JavaScript : toutes les étapes s'affichent l'une sous l'autre et le formulaire s'envoie normalement.
import { site } from '../data/site';
import { etapesQuestionnaire, type Question } from '../data/questionnaire';
import Icone from './Icone.astro';

const total = etapesQuestionnaire.length;
const id = (e: number, i: number) => `q${e}-${i}`;
const decrit = (q: Question, cle: string) => [q.aide && `${cle}-aide`, `${cle}-msg`].filter(Boolean).join(' ');
---

<section id="maquette" class="section section--alt" aria-labelledby="titre-maquette">
  <div class="conteneur form-zone">
    <div class="form-zone__texte" data-apparition>
      <p class="surtitre">Maquette gratuite</p>
      <h2 id="titre-maquette" class="titre-2">Recevez votre maquette gratuite.</h2>
      <p class="chapo">
        Quelques questions sur votre commerce, environ 3 minutes. Plus vos réponses sont précises, plus la
        maquette vous ressemblera. On vous rappelle ensuite.
      </p>
      <ul class="form-zone__points" role="list">
        <li><Icone nom="coche" />Gratuit, sans engagement</li>
        <li><Icone nom="coche" />Faite avec les photos de votre commerce</li>
        <li><Icone nom="coche" />Site en ligne en {site.delai} si vous dites oui</li>
      </ul>
      <p class="form-zone__tel">
        Vous préférez appeler ?
        <a href={`tel:${site.telephoneLien}`}>{site.telephone}</a>
      </p>
    </div>

    <div class="carte-form" data-apparition="1">
      <form class="form" action={site.formulaireAdresse} method="POST" data-formulaire data-telephone={site.telephone}>
        <div class="progres" data-progres hidden>
          <p class="progres__texte" aria-live="polite">
            Étape <span data-progres-num>1</span> sur {total} · <span data-progres-titre>{etapesQuestionnaire[0].titre}</span>
          </p>
          <div class="progres__piste" aria-hidden="true"><span class="progres__barre" data-progres-barre></span></div>
        </div>

        <input type="hidden" name="_subject" value="Nouvelle demande de maquette — Devanture" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={new URL('/merci', Astro.site).href} />
        <!-- Piège anti-robots : invisible pour les humains -->
        <div class="form__piege" aria-hidden="true">
          <label>Ne pas remplir <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="etapes-form" data-etapes>
          {
            etapesQuestionnaire.map((etape, e) => (
              <fieldset class="etape-form" data-etape={e} data-titre={etape.titre}>
                <legend class="etape-form__titre" tabindex="-1">
                  <span class="cache">Étape {e + 1} sur {total} : </span>
                  {etape.titre}
                </legend>
                <p class="etape-form__intro">{etape.intro}</p>

                <div class="etape-form__grille">
                  {etape.questions.map((q, i) => {
                    const cle = id(e, i);
                    const etoile = q.requis ? ' *' : '';
                    const facultatif = !q.requis && !q.aide && q.type !== 'cases' && q.type !== 'choix';
                    return (
                      <div class:list={['champ', { 'champ--large': q.large }]}>
                        {q.type === 'choix' || q.type === 'cases' ? (
                          <fieldset
                            class="groupe"
                            data-groupe={q.type}
                            data-requis={q.requis ? '' : undefined}
                            aria-describedby={decrit(q, cle)}
                            id={cle}
                          >
                            <legend class="champ__label">
                              {q.label}
                              {etoile}
                            </legend>
                            {q.aide && (
                              <p class="champ__aide" id={`${cle}-aide`}>
                                {q.aide}
                              </p>
                            )}
                            <div class="options">
                              {q.options!.map((o, k) => (
                                <label class="option">
                                  <input
                                    type={q.type === 'choix' ? 'radio' : 'checkbox'}
                                    name={q.nom}
                                    value={o}
                                    required={q.requis && q.type === 'choix' && k === 0}
                                  />
                                  <span>{o}</span>
                                </label>
                              ))}
                            </div>
                            <p class="champ__msg" id={`${cle}-msg`} />
                          </fieldset>
                        ) : (
                          <>
                            <label class="champ__label" for={cle}>
                              {q.label}
                              {etoile}
                              {facultatif && <span class="facultatif"> (facultatif)</span>}
                            </label>
                            {q.aide && (
                              <p class="champ__aide" id={`${cle}-aide`}>
                                {q.aide}
                              </p>
                            )}
                            {q.type === 'liste' ? (
                              <select id={cle} name={q.nom} required={q.requis} aria-describedby={decrit(q, cle)}>
                                <option value="">Choisir…</option>
                                {q.options!.map((o) => (
                                  <option>{o}</option>
                                ))}
                              </select>
                            ) : q.type === 'zone' ? (
                              <textarea
                                id={cle}
                                name={q.nom}
                                rows="3"
                                required={q.requis}
                                placeholder={q.exemple}
                                aria-describedby={decrit(q, cle)}
                              />
                            ) : (
                              <input
                                id={cle}
                                name={q.nom}
                                type={q.type === 'texte' ? 'text' : q.type}
                                required={q.requis}
                                placeholder={q.exemple}
                                autocomplete={q.autocomplete}
                                inputmode={q.type === 'tel' ? 'tel' : q.type === 'email' ? 'email' : undefined}
                                data-type={q.type}
                                aria-describedby={decrit(q, cle)}
                              />
                            )}
                            <p class="champ__msg" id={`${cle}-msg`} />
                          </>
                        )}
                      </div>
                    );
                  })}
                </div>

                {e === total - 1 && (
                  <div class="champ champ--coche">
                    <input id="f-rgpd" name="Consentement" type="checkbox" value="Oui" required aria-describedby="f-rgpd-msg" />
                    <label for="f-rgpd">
                      J’accepte que Devanture utilise ces informations pour me recontacter au sujet de ma maquette.{' '}
                      <a href="/confidentialite">Politique de confidentialité</a>.
                    </label>
                    <p class="champ__msg" id="f-rgpd-msg" />
                  </div>
                )}
              </fieldset>
            ))
          }
        </div>

        <p class="form__erreur" data-erreur-globale role="alert"></p>

        <div class="form__nav">
          <button class="btn btn--secondaire" type="button" data-retour hidden>
            <Icone nom="fleche-gauche" />
            Retour
          </button>
          <button class="btn btn--principal btn--grand" type="button" data-suite hidden>
            Continuer
            <Icone nom="fleche" />
          </button>
          <button class="btn btn--principal btn--grand form__envoyer" type="submit" data-envoyer>
            <span data-libelle>Recevoir ma maquette gratuite</span>
          </button>
        </div>
      </form>

      <div class="confirmation" data-confirmation hidden>
        <span class="confirmation__icone"><Icone nom="coche" /></span>
        <h3 class="titre-3" tabindex="-1" data-confirmation-titre>Merci, c’est bien reçu.</h3>
        <p>
          Nous vous appelons très vite <span data-confirmation-tel></span> pour convenir des photos. La maquette est
          gratuite et ne vous engage à rien.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .form-zone {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .form-zone__texte .chapo {
    margin-top: var(--e-4);
    max-width: 30rem;
  }

  .form-zone__points {
    display: grid;
    gap: var(--e-2);
    margin-top: var(--e-5);
  }

  .form-zone__points li {
    display: flex;
    gap: var(--e-2);
    align-items: center;
  }

  .form-zone__points :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--accent-texte);
  }

  .form-zone__tel {
    margin-top: var(--e-6);
    color: var(--texte-2);
  }

  .form-zone__tel a {
    display: inline-block;
    padding-block: 0.625rem;
    font-weight: 600;
  }

  .carte-form {
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border-radius: var(--r-4);
    background: var(--surface);
    border: 1px solid var(--bord);
    box-shadow: var(--ombre-2);
    scroll-margin-top: calc(var(--nav-h) + var(--e-4));
  }

  .form {
    display: grid;
    gap: var(--e-5);
  }

  .progres[hidden] {
    display: none;
  }

  .progres__texte {
    color: var(--texte-2);
    font-size: var(--t-mini);
    font-weight: 600;
  }

  .progres__piste {
    height: 0.375rem;
    margin-top: var(--e-2);
    border-radius: var(--r-rond);
    background: var(--surface-2);
    border: 1px solid var(--bord);
    overflow: hidden;
  }

  .progres__barre {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0.2);
  }

  .etapes-form {
    display: grid;
    gap: var(--e-7);
  }

  .etape-form {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .etape-form[hidden] {
    display: none;
  }

  .etape-form__titre {
    padding: 0;
    font-size: var(--t-titre-3);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .etape-form__titre:focus {
    outline: none;
  }

  .etape-form__intro {
    margin-top: var(--e-1);
    color: var(--texte-2);
  }

  .etape-form__grille {
    display: grid;
    gap: var(--e-5) var(--e-4);
    margin-top: var(--e-5);
  }

  .form__piege {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .champ {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .champ__label {
    padding: 0;
    font-size: var(--t-petit);
    font-weight: 600;
  }

  .champ__aide {
    margin-top: -0.125rem;
    color: var(--texte-2);
    font-size: var(--t-mini);
  }

  .facultatif {
    color: var(--texte-2);
    font-weight: 400;
  }

  .champ input:is([type='text'], [type='tel'], [type='email']),
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--bord-fort);
    border-radius: var(--r-1);
    background: var(--surface);
    font-size: 1rem;
    transition: border-color 150ms ease;
  }

  .champ select {
    appearance: none;
    padding-right: 2.5rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--texte-2) 50%),
      linear-gradient(135deg, var(--texte-2) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) 50%,
      calc(100% - 0.9rem) 50%;
    background-size: 0.375rem 0.375rem;
    background-repeat: no-repeat;
  }

  .champ textarea {
    resize: vertical;
    min-height: 5.5rem;
  }

  .champ :is(input, select, textarea)::placeholder {
    color: var(--texte-3);
  }

  .champ :is(input, select, textarea):focus-visible {
    outline-offset: 1px;
    border-color: var(--focus);
  }

  .champ [aria-invalid='true'] {
    border-color: var(--erreur) !important;
  }

  .champ__msg {
    color: var(--erreur);
    font-size: var(--t-mini);
    font-weight: 500;
  }

  .champ__msg:empty {
    display: none;
  }

  .groupe {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: 0.25rem;
  }

  .option {
    position: relative;
    display: inline-flex;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .option input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .option span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--bord-fort);
    border-radius: var(--r-rond);
    background: var(--surface);
    font-size: var(--t-petit);
    line-height: 1.25;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      transform 120ms ease-out;
  }

  .option:active span {
    transform: scale(0.97);
    transition-duration: 60ms;
  }

  .option input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--sur-accent);
    font-weight: 600;
  }

  .option input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .groupe[aria-invalid='true'] .option span {
    border-color: var(--erreur);
  }

  .champ--coche {
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--e-3);
    margin-top: var(--e-6);
  }

  .champ--coche input {
    width: 1.375rem;
    height: 1.375rem;
    margin: 0.125rem 0 0;
    accent-color: var(--accent);
  }

  .champ--coche label {
    color: var(--texte-2);
    font-size: var(--t-petit);
  }

  .champ--coche .champ__msg {
    grid-column: 2;
  }

  .form__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  .form__nav [hidden] {
    display: none;
  }

  .form__nav .btn--principal {
    flex: 1;
  }

  .form__envoyer[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .form__erreur:empty {
    display: none;
  }

  .form__erreur {
    padding: var(--e-3) var(--e-4);
    border-radius: var(--r-1);
    background: var(--erreur-doux);
    color: var(--erreur);
    font-size: var(--t-petit);
    font-weight: 500;
  }

  .confirmation {
    display: grid;
    justify-items: start;
    gap: var(--e-3);
    padding-block: var(--e-5);
  }

  .confirmation[hidden] {
    display: none;
  }

  .confirmation__icone {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--sur-accent);
  }

  .confirmation__icone :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .confirmation p {
    color: var(--texte-2);
  }

  @media (min-width: 36rem) {
    .etape-form__grille {
      grid-template-columns: 1fr 1fr;
    }

    .champ--large {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .form-zone {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .form-zone__texte {
      position: sticky;
      top: calc(var(--nav-h) + var(--e-6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .option:active span {
      transform: none;
    }
  }
</style>

<script>
  import { brancherFormulaires } from '../scripts/formulaire';
  brancherFormulaires();
</script>
