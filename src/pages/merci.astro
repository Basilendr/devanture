---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base titre="Merci — Devanture" navSimple indexable={false}>
  <section class="section conteneur" style="text-align:center">
    <h1 class="titre-2">Merci, c’est bien reçu.</h1>
    <p class="chapo" style="margin-block:1rem 2rem">
      Nous vous appelons très vite pour convenir des photos. Une question ? {site.telephone}
    </p>
    <a class="btn btn--principal" href="/">Retour à l’accueil</a>
  </section>
</Base>
